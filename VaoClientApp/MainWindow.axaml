<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="using:LibVLCSharp.Avalonia"
        x:Class="Vao.Sample.MainWindow"
        Title="HERNIS FLEX VAO API Demo"
        Width="1226" Height="1002" MinWidth="400" MinHeight="200"
        Background="{DynamicResource AppBg}">

    <Grid ColumnDefinitions="280,*">
        <!-- Left panel - scrollable sections -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Classes="sidebar-shell" Margin="6,3,0,3">
                <StackPanel Spacing="8">

                    <!-- Connection -->
                    <Border Classes="sidebar-card">
                        <Expander Classes="sidebar-section" x:Name="expConnection" Header="Connection" IsExpanded="True" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="2" Margin="8,4,8,8">
                                <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Host" Foreground="{DynamicResource LabelFg}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtHost"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" Foreground="{DynamicResource LabelFg}" VerticalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPort" Text="444" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="User" Foreground="{DynamicResource LabelFg}" VerticalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtUser" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Password" Foreground="{DynamicResource LabelFg}" VerticalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtPassword" PasswordChar="*" Margin="0,2,0,0"/>
                                </Grid>
                                <CheckBox x:Name="chkSecure" Content="Secure" IsChecked="True"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="btnConnect" Content="Connect" Click="btnConnect_Click"/>
                                    <Button x:Name="btnDisconnect" Content="Disconnect" Click="btnDisconnect_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Camera Control -->
                    <Border Classes="sidebar-card">
                        <Expander Classes="sidebar-section" x:Name="expCameraControl" Header="Camera Control" IsExpanded="True" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4" Margin="8,4,8,8" x:Name="grpCameraControl" IsEnabled="False">
                                <Grid ColumnDefinitions="34,34,34,*,34,34" RowDefinitions="34,34,34">
                            <!-- PTZ: row0=FocusNear/TiltUp/ZoomIn, row1=PanLeft/icon/PanRight, row2=FocusFar/TiltDown/ZoomOut -->
                            <Button Grid.Row="0" Grid.Column="0" x:Name="btnFocusNear" ToolTip.Tip="Focus Near" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="30" Height="30" Padding="2">
                                <Image x:Name="imgFocusNear" Classes="theme-icon" Width="20" Height="20"/>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="1" x:Name="btnTiltUp" ToolTip.Tip="Tilt Up" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="30" Height="30" Padding="2">
                                <Image x:Name="imgTiltUp" Classes="theme-icon" Width="20" Height="20"/>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="2" x:Name="btnZoomIn" ToolTip.Tip="Zoom In" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="30" Height="30" Padding="2">
                                <Image x:Name="imgZoomIn" Classes="theme-icon" Width="20" Height="20"/>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="0" x:Name="btnPanLeft" ToolTip.Tip="Pan Left" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="30" Height="30" Padding="2">
                                <Image x:Name="imgPanLeft" Classes="theme-icon" Width="20" Height="20"/>
                            </Button>
                            <Image Grid.Row="1" Grid.Column="1" x:Name="imgCenterCamera" Classes="theme-icon" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Button Grid.Row="1" Grid.Column="2" x:Name="btnPanRight" ToolTip.Tip="Pan Right" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="30" Height="30" Padding="2">
                                <Image x:Name="imgPanRight" Classes="theme-icon" Width="20" Height="20"/>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="0" x:Name="btnFocusFar" ToolTip.Tip="Focus Far" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="30" Height="30" Padding="2">
                                <Image x:Name="imgFocusFar" Classes="theme-icon" Width="20" Height="20"/>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="1" x:Name="btnTiltDown" ToolTip.Tip="Tilt Down" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="30" Height="30" Padding="2">
                                <Image x:Name="imgTiltDown" Classes="theme-icon" Width="20" Height="20"/>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="2" x:Name="btnZoomOut" ToolTip.Tip="Zoom Out" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="30" Height="30" Padding="2">
                                <Image x:Name="imgZoomOut" Classes="theme-icon" Width="20" Height="20"/>
                            </Button>
                            <!-- Extra controls on right side -->
                            <Button Grid.Row="0" Grid.Column="4" x:Name="btnAbsolutePosition" ToolTip.Tip="Absolute Position" Click="btnOpenAbsolutePositionWindow_Click" Width="30" Height="30" Padding="2">
                                <Image x:Name="imgAbsolutePosition" Classes="theme-icon" Width="20" Height="20"/>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="4" x:Name="btnCameraLock" ToolTip.Tip="Camera Lock" Click="btnCameraLock_Click" Width="30" Height="30" Padding="2">
                                <Image x:Name="imgCameraLock" Classes="theme-icon" Width="20" Height="20"/>
                            </Button>
                                </Grid>
                                <TextBlock x:Name="lblCurrentCamera" Text="Camera : (No camera selected)" Foreground="{DynamicResource LabelFg}" FontSize="11"/>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Camera Selection -->
                    <Border Classes="sidebar-card">
                        <Expander Classes="sidebar-section" x:Name="expCameraSelection" Header="Camera Selection" IsExpanded="True" HorizontalAlignment="Stretch">
                            <WrapPanel x:Name="pnlCameraSelectFlowPanel" Margin="8,6,8,8" IsEnabled="False"/>
                        </Expander>
                    </Border>

                    <!-- Preset Selection -->
                    <Border Classes="sidebar-card">
                        <Expander Classes="sidebar-section" x:Name="expPresetSelection" Header="Preset Selection" IsExpanded="True" HorizontalAlignment="Stretch">
                            <StackPanel x:Name="grpSelectPreset" Spacing="6" Margin="8,6,8,8" IsEnabled="False">
                                <Grid ColumnDefinitions="*,Auto">
                                    <ComboBox Grid.Column="0" x:Name="selPreset" MinWidth="0" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="1" x:Name="btnGotoPreset" Content="Go" Click="btnGotoPreset_Click" MinWidth="64" Margin="8,0,0,0" HorizontalAlignment="Stretch"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Alarms -->
                    <Border Classes="sidebar-card">
                        <Expander Classes="sidebar-section" x:Name="expAlarms" Header="Alarms" IsExpanded="True" HorizontalAlignment="Stretch">
                            <WrapPanel x:Name="pnlAlarms" Margin="8,6,8,8"/>
                        </Expander>
                    </Border>

                    <!-- Playback Selection -->
                    <Border Classes="sidebar-card">
                        <Expander Classes="sidebar-section" x:Name="expPlaybackSelection" Header="Playback Selection" IsExpanded="True" HorizontalAlignment="Stretch">
                            <StackPanel x:Name="grpSelectPlayback" Spacing="12" Margin="12,10,12,12" IsEnabled="False">
                                <ComboBox x:Name="selPlayback" MinWidth="200" HorizontalAlignment="Stretch" SelectionChanged="selPlayback_SelectedIndexChanged"/>
                                <Grid ColumnDefinitions="*,8,*">
                                    <Button Grid.Column="0" x:Name="btnPlayPlayback" Content="Play" Click="btnPlayPlayback_Click" HorizontalAlignment="Stretch" MinWidth="80"/>
                                    <Button Grid.Column="2" x:Name="btnStopPlayback" Content="Stop" Click="btnStopPlayback_Click" HorizontalAlignment="Stretch" MinWidth="80"/>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Date (YYYY-MM-DD)" FontSize="10" Foreground="{DynamicResource LabelFg}"/>
                                    <Grid ColumnDefinitions="*,4,32">
                                        <TextBox Grid.Column="0" x:Name="txtDatePlayback" Watermark="2024-01-15" HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="2" x:Name="btnPickDate" Content="📅" FontSize="14" Padding="4" Click="btnPickDate_Click" ToolTip.Tip="Pick date"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Time (HH:MM:SS)" FontSize="10" Foreground="{DynamicResource LabelFg}"/>
                                    <Grid ColumnDefinitions="*,4,32">
                                        <TextBox Grid.Column="0" x:Name="txtTimePlayback" Watermark="14:30:00" HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="2" x:Name="btnPickTime" Content="🕐" FontSize="14" Padding="4" Click="btnPickTime_Click" ToolTip.Tip="Pick time"/>
                                    </Grid>
                                </StackPanel>
                                <Button x:Name="btnGotoTime" Content="Go to time" Click="btnGotoTime_Click" HorizontalAlignment="Stretch" MinWidth="100"/>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Download Recording -->
                    <Border Classes="sidebar-card">
                        <Expander Classes="sidebar-section" x:Name="expDownloadRecording" Header="Download Recording" IsExpanded="True" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4" Margin="8,6,8,8">
                                <TextBlock Text="Export video." Foreground="{DynamicResource LabelFg}" FontSize="11" TextWrapping="Wrap"/>
                                <Button x:Name="btnDownload" Content="Open Download Window" Click="btnOpenDownloadWindow_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Settings -->
                    <Border Classes="sidebar-card">
                        <Expander Classes="sidebar-section" x:Name="expSettings" Header="Settings" IsExpanded="False" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4" Margin="8,6,8,8">
                                <CheckBox x:Name="chkDarkMode" Content="Dark Mode" IsChecked="True" Checked="chkDarkMode_Changed" Unchecked="chkDarkMode_Changed"/>
                            </StackPanel>
                        </Expander>
                    </Border>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Right panel - video + messages -->
        <Grid Grid.Column="1" RowDefinitions="*,140" Margin="4">
            <!-- Video area -->
            <Border Grid.Row="0" x:Name="grpVideoControl" Background="{DynamicResource SectionBg}" CornerRadius="2">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <Border Grid.Row="0" x:Name="brdVideoHeader" Background="#424D5F" CornerRadius="2,2,0,0">
                        <TextBlock x:Name="txtVideoHeader" Text="No Camera Selected" FontWeight="Bold" Foreground="White" Margin="5"/>
                    </Border>
                    <Panel Grid.Row="1" x:Name="pnlVideo" Background="{DynamicResource VideoBg}"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="4">
                        <CheckBox x:Name="chkPreferSubChannel" Content="Prefer Sub Channel" IsChecked="True" Checked="chkPreferSubChannel_CheckedChanged" Unchecked="chkPreferSubChannel_CheckedChanged"/>
                        <CheckBox x:Name="chkUseTcp" Content="Use TCP" Checked="chkUseTcp_CheckedChanged" Unchecked="chkUseTcp_CheckedChanged"/>
                    </StackPanel>
                    <TextBox Grid.Row="3" x:Name="txtCurrentRtspUrl" IsReadOnly="True" FontSize="10" Margin="4,0,4,4"/>
                </Grid>
            </Border>

            <!-- Messages -->
            <Border Grid.Row="1" Background="{DynamicResource SectionBg}" CornerRadius="2" Margin="0,4,0,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="Messages" FontWeight="Bold" Margin="8,4"/>
                    <ListBox Grid.Row="1" x:Name="lstMessages" Background="Transparent" FontFamily="Consolas" FontSize="11" Margin="4,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" x:Name="btnClearMessages" Content="Clear" Click="btnClearMessages_Click" HorizontalAlignment="Right" Margin="4"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
