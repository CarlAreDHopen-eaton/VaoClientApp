<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="using:LibVLCSharp.Avalonia"
        x:Class="Vao.Sample.MainWindow"
        Title="HERNIS FLEX VAO API Demo"
        Width="1226" Height="1002" MinWidth="400" MinHeight="200"
        Background="{DynamicResource AppBg}">

    <Grid x:Name="rootLayoutGrid" RowDefinitions="Auto,*">
        <!-- Top App Bar (64px per Brightlayer UI) -->
        <Border x:Name="mainTopBar" Grid.Row="0" Height="{DynamicResource AppBarHeight}" Background="{DynamicResource Primary}" BoxShadow="0 2 4 0 #40000000" ClipToBounds="True">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0">
                <!-- Left: Hamburger + App Title + Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="btnToggleSidebarAppBar" 
                            Click="btnToggleSidebar_Click"
                            Classes="appbar-icon"
                            ToolTip.Tip="Toggle sidebar (F9)"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE5D2;" Classes="ms-icon" FontSize="24" Foreground="{DynamicResource PrimaryHeaderFg}"/>
                    </Button>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="txtAppTitle" Text="HERNIS FLEX VAO" 
                                   Classes="page-header-title"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryHeaderFg}"/>
                        <TextBlock x:Name="txtAppSubtitle" Text="Test application for the HERNIS FLEX API" 
                                   Classes="page-header-subtitle"
                                   Foreground="{DynamicResource PrimaryHeaderFg}"
                                   Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: User Profile Avatar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button x:Name="btnUserProfile"
                            Width="{DynamicResource AvatarSize}" Height="{DynamicResource AvatarSize}"
                            Background="{DynamicResource PrimaryDark}"
                            CornerRadius="{DynamicResource AvatarCornerRadius}"
                            Padding="0"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="User Profile"
                            Click="btnUserProfile_Click">
                        <TextBlock x:Name="txtUserInitial" 
                                   Text="U" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryHeaderFg}"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem x:Name="menuItemUsername" IsEnabled="False">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xF0D3;" Classes="ms-icon" FontSize="18"/>
                                    </MenuItem.Icon>
                                    <MenuItem.Header>
                                        <TextBlock x:Name="txtMenuUsername" Text="Not logged in"/>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator/>
                                <MenuItem x:Name="menuItemLogin" Header="Login" Click="menuItemLogin_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE73C;" Classes="ms-icon" FontSize="18"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="menuItemThemeSelect" Header="Theme"/>
                                <MenuItem Click="menuItemSettings_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE8B8;" Classes="ms-icon" FontSize="18"/>
                                    </MenuItem.Icon>
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Settings"/>
                                            <TextBlock Text="F12" Opacity="0.5" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="menuItemLogout" Header="Logout" Click="menuItemLogout_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE9BA;" Classes="ms-icon" FontSize="18"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <!-- Left panel - collapsible sidebar (280px expanded, 56px collapsed) -->
            <Grid Grid.Column="0" x:Name="sidebarGrid" Width="{DynamicResource SidebarWidth}">
                <!-- Narrow icon rail (visible when collapsed) -->
                <Border x:Name="narrowSidebar" IsVisible="False" Background="{DynamicResource Surface1}">
                    <StackPanel Spacing="4" Margin="0,8" HorizontalAlignment="Center">
                        <Button Classes="icon" Click="btnExpandCameraControl_Click" ToolTip.Tip="Camera Control">
                            <TextBlock Text="&#xE30F;" Classes="ms-icon" FontSize="20" Foreground="{DynamicResource SidebarHeaderFg}"/>
                        </Button>
                        <Button Classes="icon" Click="btnExpandCameraSelection_Click" ToolTip.Tip="Camera Selection">
                            <TextBlock Text="&#xE412;" Classes="ms-icon" FontSize="20" Foreground="{DynamicResource SidebarHeaderFg}"/>
                        </Button>
                        <Button Classes="icon" Click="btnExpandPresetSelection_Click" ToolTip.Tip="Preset Selection">
                            <TextBlock Text="&#xE55E;" Classes="ms-icon" FontSize="20" Foreground="{DynamicResource SidebarHeaderFg}"/>
                        </Button>
                        <Button Classes="icon" Click="btnExpandAlarms_Click" ToolTip.Tip="Alarms">
                            <TextBlock Text="&#xE7F5;" Classes="ms-icon" FontSize="20" Foreground="{DynamicResource SidebarHeaderFg}"/>
                        </Button>
                        <Button Classes="icon" Click="btnExpandPlayback_Click" ToolTip.Tip="Playback Selection">
                            <TextBlock Text="&#xE037;" Classes="ms-icon" FontSize="20" Foreground="{DynamicResource SidebarHeaderFg}"/>
                        </Button>
                        <Button Classes="icon" Click="btnExpandDownload_Click" ToolTip.Tip="Download Recording">
                            <TextBlock Text="&#xF090;" Classes="ms-icon" FontSize="20" Foreground="{DynamicResource SidebarHeaderFg}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Full sidebar content (visible when expanded) -->
                <ScrollViewer x:Name="fullSidebar" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Classes="sidebar-shell">
                        <StackPanel Spacing="0" x:Name="sidebarContent">

                            <!-- Camera Control -->
                            <Border Classes="sidebar-card">
                                <Expander Classes="sidebar-section" x:Name="expCameraControl" IsExpanded="True" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="&#xE30F;" Classes="ms-icon" FontSize="{DynamicResource IconSize}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Camera Control" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="8" Margin="16,8,16,16" x:Name="grpCameraControl" IsEnabled="False">
                                       <Grid ColumnDefinitions="48,48,48,*,48,48" RowDefinitions="48,48,48">
                                           <!-- PTZ Controls -->
                                           <Button Grid.Row="0" Grid.Column="0" x:Name="btnFocusNear" ToolTip.Tip="Focus Near" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="{DynamicResource ButtonMinHeight}" Height="{DynamicResource ButtonMinHeight}" Padding="2" Classes="ptz-icon">
                                               <TextBlock x:Name="iconFocusNear" Text="&#xE883;" Classes="ms-icon" Foreground="{DynamicResource SidebarHeaderFg}"/>
                                           </Button>
                                           <Button Grid.Row="0" Grid.Column="1" x:Name="btnTiltUp" ToolTip.Tip="Tilt Up" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="{DynamicResource ButtonMinHeight}" Height="{DynamicResource ButtonMinHeight}" Padding="2" Classes="ptz-icon">
                                               <TextBlock x:Name="iconTiltUp" Text="&#xE5D8;" Classes="ms-icon" Foreground="{DynamicResource SidebarHeaderFg}"/>
                                           </Button>
                                           <Button Grid.Row="0" Grid.Column="2" x:Name="btnZoomIn" ToolTip.Tip="Zoom In" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="{DynamicResource ButtonMinHeight}" Height="{DynamicResource ButtonMinHeight}" Padding="2" Classes="ptz-icon">
                                               <TextBlock x:Name="iconZoomIn" Text="&#xE8FF;" Classes="ms-icon" Foreground="{DynamicResource SidebarHeaderFg}"/>
                                           </Button>
                                           <Button Grid.Row="1" Grid.Column="0" x:Name="btnPanLeft" ToolTip.Tip="Pan Left" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="{DynamicResource ButtonMinHeight}" Height="{DynamicResource ButtonMinHeight}" Padding="2" Classes="ptz-icon">
                                               <TextBlock x:Name="iconPanLeft" Text="&#xE5C4;" Classes="ms-icon" Foreground="{DynamicResource SidebarHeaderFg}"/>
                                           </Button>
                                           <Button Grid.Row="1" Grid.Column="1" x:Name="btnCenterCamera" IsHitTestVisible="False" Width="{DynamicResource ButtonMinHeight}" Height="{DynamicResource ButtonMinHeight}" Padding="2" Classes="ptz-icon ptz-icon-transparent">
                                               <TextBlock x:Name="iconCenterCamera" Text="&#xE074;" Classes="ms-icon" Foreground="{DynamicResource SidebarHeaderFg}"/>
                                           </Button>
                                           <Button Grid.Row="1" Grid.Column="2" x:Name="btnPanRight" ToolTip.Tip="Pan Right" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="{DynamicResource ButtonMinHeight}" Height="{DynamicResource ButtonMinHeight}" Padding="2" Classes="ptz-icon">
                                               <TextBlock x:Name="iconPanRight" Text="&#xE5C8;" Classes="ms-icon" Foreground="{DynamicResource SidebarHeaderFg}"/>
                                           </Button>
                                           <Button Grid.Row="2" Grid.Column="0" x:Name="btnFocusFar" ToolTip.Tip="Focus Far" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="{DynamicResource ButtonMinHeight}" Height="{DynamicResource ButtonMinHeight}" Padding="2" Classes="ptz-icon">
                                               <TextBlock x:Name="iconFocusFar" Text="&#xE882;" Classes="ms-icon" Foreground="{DynamicResource SidebarHeaderFg}"/>
                                           </Button>
                                           <Button Grid.Row="2" Grid.Column="1" x:Name="btnTiltDown" ToolTip.Tip="Tilt Down" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="{DynamicResource ButtonMinHeight}" Height="{DynamicResource ButtonMinHeight}" Padding="2" Classes="ptz-icon">
                                               <TextBlock x:Name="iconTiltDown" Text="&#xE5DB;" Classes="ms-icon" Foreground="{DynamicResource SidebarHeaderFg}"/>
                                           </Button>
                                           <Button Grid.Row="2" Grid.Column="2" x:Name="btnZoomOut" ToolTip.Tip="Zoom Out" PointerPressed="OnControlCameraPointerPressed" PointerReleased="OnControlCameraPointerReleased" Width="{DynamicResource ButtonMinHeight}" Height="{DynamicResource ButtonMinHeight}" Padding="2" Classes="ptz-icon">
                                               <TextBlock x:Name="iconZoomOut" Text="&#xE900;" Classes="ms-icon" Foreground="{DynamicResource SidebarHeaderFg}"/>
                                           </Button>
                                           <!-- Extra controls -->
                                           <Button Grid.Row="0" Grid.Column="4" x:Name="btnAbsolutePosition" ToolTip.Tip="Absolute Position" Click="btnOpenAbsolutePositionWindow_Click" Width="{DynamicResource ButtonMinHeight}" Height="{DynamicResource ButtonMinHeight}" Padding="2" Classes="ptz-icon">
                                               <TextBlock x:Name="iconAbsolutePosition" Text="&#xE074;" Classes="ms-icon" Foreground="{DynamicResource SidebarHeaderFg}"/>
                                           </Button>
                                           <Button Grid.Row="1" Grid.Column="4" x:Name="btnCameraLock" ToolTip.Tip="Camera Lock" Click="btnCameraLock_Click" Width="{DynamicResource ButtonMinHeight}" Height="{DynamicResource ButtonMinHeight}" Padding="2" Classes="ptz-icon">
                                               <TextBlock x:Name="iconCameraLock" Text="&#xE898;" Classes="ms-icon" Foreground="{DynamicResource SidebarHeaderFg}"/>
                                           </Button>
                                       </Grid>
                                        <TextBlock x:Name="lblCurrentCamera" Text="Camera: (No camera selected)" Foreground="{DynamicResource LabelFg}" FontSize="12"/>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <!-- Camera Selection -->
                            <Border Classes="sidebar-card">
                                <Expander Classes="sidebar-section camera-selection-section" x:Name="expCameraSelection" IsExpanded="True" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="&#xE412;" Classes="ms-icon" FontSize="{DynamicResource IconSize}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Camera Selection" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <Grid x:Name="pnlCameraSelection" Margin="0" IsEnabled="False" RowDefinitions="Auto,Auto,Auto">
                                        <TextBox Grid.Row="0"
                                                 x:Name="txtCameraSearch"
                                                 Watermark="Search by number or name"
                                                 Classes="borderless"
                                                 MinHeight="{DynamicResource SidebarSelectorSearchMinHeight}"
                                                 TextChanged="txtCameraSearch_TextChanged"/>
                                        <ListBox Grid.Row="1"
                                                 x:Name="lstCameraSelection"
                                                 SelectionChanged="lstCameraSelection_SelectionChanged"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 Background="Transparent"
                                                 BorderBrush="{DynamicResource Divider}"
                                                 BorderThickness="1"
                                                 CornerRadius="4"
                                                 Padding="0"
                                                 Margin="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding CameraTypeIcon}"
                                                                   Classes="ms-icon"
                                                                   FontSize="18"
                                                                   Foreground="{DynamicResource LabelFg}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding CameraNumberText}"
                                                                   Margin="6,0,6,0"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource LabelFg}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding CameraName}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding CameraName}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border Grid.Row="2"
                                                Classes="selector-resize-handle"
                                                Tag="camera"
                                                PointerPressed="SelectorResizeHandle_PointerPressed"
                                                PointerMoved="SelectorResizeHandle_PointerMoved"
                                                PointerReleased="SelectorResizeHandle_PointerReleased"
                                                PointerCaptureLost="SelectorResizeHandle_PointerCaptureLost"/>
                                    </Grid>
                                </Expander>
                            </Border>

                            <!-- Preset Selection -->
                            <Border Classes="sidebar-card">
                                <Expander Classes="sidebar-section" x:Name="expPresetSelection" IsExpanded="True" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="&#xE55E;" Classes="ms-icon" FontSize="{DynamicResource IconSize}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Preset Selection" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel x:Name="grpSelectPreset" Spacing="8" Margin="16,8,16,16" IsEnabled="False">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ComboBox Grid.Column="0" x:Name="selPreset" MinWidth="0" HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="1" x:Name="btnGotoPreset" Content="Go" Click="btnGotoPreset_Click" MinWidth="64" Margin="8,0,0,0" Classes="primary"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <!-- Alarms -->
                            <Border Classes="sidebar-card">
                                <Expander Classes="sidebar-section alarm-selection-section" x:Name="expAlarms" IsExpanded="True" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="&#xE7F5;" Classes="ms-icon" FontSize="{DynamicResource IconSize}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Alarms" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <Grid x:Name="pnlAlarmsSelection" Margin="0" IsEnabled="False" RowDefinitions="Auto,Auto,Auto">
                                        <TextBox Grid.Row="0"
                                                 x:Name="txtAlarmSearch"
                                                 Watermark="Search by number or name"
                                                 Classes="borderless"
                                                 MinHeight="{DynamicResource SidebarSelectorSearchMinHeight}"
                                                 TextChanged="txtAlarmSearch_TextChanged"/>
                                        <ListBox Grid.Row="1"
                                                 x:Name="lstAlarmSelection"
                                                 SelectionChanged="lstAlarmSelection_SelectionChanged"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 Background="Transparent"
                                                 BorderBrush="{DynamicResource Divider}"
                                                 BorderThickness="1"
                                                 CornerRadius="4"
                                                 Padding="0"
                                                 Margin="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="&#xE7F5;"
                                                                   Classes="ms-icon"
                                                                   FontSize="16"
                                                                   Foreground="{Binding StatusBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding AlarmNumberText}"
                                                                   Margin="6,0,6,0"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource LabelFg}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding AlarmName}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding AlarmName}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border Grid.Row="2"
                                                Classes="selector-resize-handle"
                                                Tag="alarm"
                                                PointerPressed="SelectorResizeHandle_PointerPressed"
                                                PointerMoved="SelectorResizeHandle_PointerMoved"
                                                PointerReleased="SelectorResizeHandle_PointerReleased"
                                                PointerCaptureLost="SelectorResizeHandle_PointerCaptureLost"/>
                                    </Grid>
                                </Expander>
                            </Border>

                            <!-- Playback Selection -->
                            <Border Classes="sidebar-card">
                                <Expander Classes="sidebar-section" x:Name="expPlaybackSelection" IsExpanded="True" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="&#xE037;" Classes="ms-icon" FontSize="{DynamicResource IconSize}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Playback Selection" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel x:Name="grpSelectPlayback" Spacing="16" Margin="16,8,16,16" IsEnabled="False">
                                        <ComboBox x:Name="selPlayback" MinWidth="200" HorizontalAlignment="Stretch" SelectionChanged="selPlayback_SelectedIndexChanged"/>
                                        <Grid ColumnDefinitions="*,8,*">
                                            <!-- Play = Primary (high emphasis), Stop = Outlined (medium emphasis) -->
                                            <Button Grid.Column="0" x:Name="btnPlayPlayback" Content="Play" Click="btnPlayPlayback_Click" HorizontalAlignment="Stretch" Classes="primary"/>
                                            <Button Grid.Column="2" x:Name="btnStopPlayback" Content="Stop" Click="btnStopPlayback_Click" HorizontalAlignment="Stretch" Classes="outlined"/>
                                        </Grid>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Date (YYYY-MM-DD)" Classes="label"/>
                                            <Grid ColumnDefinitions="*,8,44">
                                                <TextBox Grid.Column="0" x:Name="txtDatePlayback" Watermark="2024-01-15" HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="2" x:Name="btnPickDate" Click="btnPickDate_Click" ToolTip.Tip="Pick date" Classes="icon" Width="{DynamicResource ButtonMinHeight}" Height="{DynamicResource ButtonMinHeight}">
                                                                                                    <TextBlock Text="&#xE935;" Classes="ms-icon" FontSize="20"/>
                                                                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Time (HH:MM:SS)" Classes="label"/>
                                            <Grid ColumnDefinitions="*,8,44">
                                                <TextBox Grid.Column="0" x:Name="txtTimePlayback" Watermark="14:30:00" HorizontalAlignment="Stretch"/>
                                                <Button Grid.Column="2" x:Name="btnPickTime" Click="btnPickTime_Click" ToolTip.Tip="Pick time" Classes="icon" Width="{DynamicResource ButtonMinHeight}" Height="{DynamicResource ButtonMinHeight}">
                                                                                                    <TextBlock Text="&#xE8B5;" Classes="ms-icon" FontSize="20"/>
                                                                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                        <Button x:Name="btnGotoTime" Content="Go to Time" Click="btnGotoTime_Click" HorizontalAlignment="Stretch" Classes="primary"/>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <!-- Download Recording -->
                            <Border Classes="sidebar-card">
                                <Expander Classes="sidebar-section" x:Name="expDownloadRecording" IsExpanded="True" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="&#xF090;" Classes="ms-icon" FontSize="{DynamicResource IconSize}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Download Recording" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="8" Margin="16,8,16,16">
                                        <TextBlock Text="Export video recordings." Classes="label" TextWrapping="Wrap"/>
                                        <Button x:Name="btnDownload" Content="Download" Click="btnOpenDownloadWindow_Click" HorizontalAlignment="Stretch" Classes="outlined"/>
                                    </StackPanel>
                                </Expander>
                            </Border>

                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- Right panel - video + messages -->
            <Grid Grid.Column="1" RowDefinitions="3*,Auto,*" Margin="8">
                <!-- Floating hamburger button (when sidebar collapsed) -->
                <Button x:Name="btnOpenSidebar" 
                        Click="btnToggleSidebar_Click"
                        Classes="fab"
                        Width="48" Height="48"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16"
                        IsVisible="False"
                        ToolTip.Tip="Open sidebar"
                        Grid.Row="0"
                        ZIndex="100">
                    <TextBlock Text="&#xE5D2;" Classes="ms-icon" FontSize="20" Foreground="White"/>
                </Button>

                <!-- Video area -->
                <Border Grid.Row="0" x:Name="grpVideoControl" Background="{DynamicResource SectionBg}" CornerRadius="4">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" x:Name="brdVideoHeader" Background="{DynamicResource VideoHeaderBg}" CornerRadius="4,4,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="txtVideoHeader" Text="No Camera Selected" FontWeight="SemiBold" FontSize="14" Foreground="White" Margin="16,6" Opacity="0.87" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1"
                                      ColumnDefinitions="Auto,Auto"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0">
                                    <ToggleSwitch x:Name="tglSubChannel"
                                                  Grid.Column="0"
                                                  OnContent="Sub" OffContent="Main"
                                                  IsChecked="True"
                                                  Checked="tglSubChannel_CheckedChanged"
                                                  Unchecked="tglSubChannel_CheckedChanged"
                                                  VerticalAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  HorizontalContentAlignment="Center"
                                                  Padding="0"
                                                  Margin="0,0,8,0"
                                                  MinHeight="0"
                                                  Foreground="White"/>
                                    <Button x:Name="btnVideoMenuHeader"
                                            Grid.Column="1"
                                            Classes="appbar-icon"
                                            Click="VideoMenuButton_Click"
                                            ToolTip.Tip="Video menu"
                                            VerticalAlignment="Center"
                                            Width="{DynamicResource ButtonMinHeight}"
                                            Height="{DynamicResource ButtonMinHeight}"
                                            Padding="0">
                                        <TextBlock Text="&#xE5D4;" Classes="ms-icon" FontSize="18" Foreground="White"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                        <Panel Grid.Row="1" x:Name="pnlVideo" Background="{DynamicResource VideoBg}"/>
                        <TextBox Grid.Row="2" x:Name="txtCurrentRtspUrl" IsReadOnly="True" FontSize="11" Margin="16,8,16,12" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource LabelFg}" IsVisible="False"/>
                    </Grid>
                </Border>

                <!-- Splitter between video and messages -->
                <GridSplitter Grid.Row="1" x:Name="messagesSplitter" Height="6" HorizontalAlignment="Stretch" 
                              Background="Transparent" Margin="0,2"
                              ResizeDirection="Rows"
                              DragCompleted="MessagesSplitter_DragCompleted"/>

                <!-- Messages -->
                <Border Grid.Row="2" x:Name="brdMessages" Background="{DynamicResource SectionBg}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="4" MinHeight="36">
                    <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="{DynamicResource Surface3}" CornerRadius="4,4,0,0" 
                                Cursor="Hand" PointerPressed="MessagesHeader_PointerPressed">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock x:Name="txtMessagesToggle" Text="▼" FontSize="12" Foreground="{DynamicResource SidebarHeaderFg}" 
                                           Margin="16,12,4,12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Messages" FontWeight="SemiBold" FontSize="14" 
                                           Foreground="{DynamicResource SidebarHeaderFg}" Margin="4,12,16,12"/>
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1" x:Name="lstMessages" Background="Transparent" FontFamily="{StaticResource MonospaceFont}" FontSize="12" Margin="12,8" SelectionMode="Multiple" KeyDown="lstMessages_KeyDown">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="4,1"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Scroll to End" Click="menuScrollToEnd_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Copy Selected" Click="menuCopySelectedMessages_Click"/>
                                    <MenuItem Header="Copy All" Click="menuCopyMessages_Click"/>
                                    <MenuItem Header="Clear" Click="btnClearMessages_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="menuFilterFlexApi" Header="Show FlexApi" Click="menuFilterFlexApi_Click">
                                        <MenuItem.Icon>
                                            <CheckBox IsChecked="True" IsHitTestVisible="False"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="menuFilterLibVlc" Header="Show LibVlc" Click="menuFilterLibVlc_Click">
                                        <MenuItem.Icon>
                                            <CheckBox IsChecked="True" IsHitTestVisible="False"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="menuFilterConfig" Header="Show Config" Click="menuFilterConfig_Click">
                                        <MenuItem.Icon>
                                            <CheckBox IsChecked="True" IsHitTestVisible="False"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Background}" CornerRadius="2" Padding="4,1">
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Navigation Host for tablet/mobile pages - overlays main content when in use -->
            <Border x:Name="pickerOverlay"
                    Grid.Column="0" Grid.ColumnSpan="2"
                    Background="#80000000"
                    IsVisible="False"
                    ZIndex="900">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" MaxWidth="520">
                    <Border Background="{DynamicResource SectionBg}"
                            BorderBrush="{DynamicResource Divider}"
                            BorderThickness="1"
                            CornerRadius="8"
                            MinWidth="320">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Border Grid.Row="0" Background="{DynamicResource Primary}" CornerRadius="8,8,0,0" Padding="20,14">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="txtPickerOverlayTitle"
                                               Text="Select Date"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock x:Name="txtPickerOverlaySubtitle"
                                               Text="Choose a date for playback"
                                               FontSize="12"
                                               Foreground="White"
                                               Opacity="0.75"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Padding="20">
                                <Grid>
                                    <DatePicker x:Name="overlayDatePicker" IsVisible="False" MinHeight="{DynamicResource InputMinHeight}" HorizontalAlignment="Stretch"/>
                                    <TimePicker x:Name="overlayTimePicker" IsVisible="False" MinHeight="{DynamicResource InputMinHeight}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="16">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                    <Button Content="Cancel" Click="btnPickerOverlayCancel_Click" Classes="outlined" MinWidth="110" MinHeight="{DynamicResource ButtonMinHeight}"/>
                                    <Button Content="Apply" Click="btnPickerOverlayApply_Click" Classes="primary" MinWidth="110" MinHeight="{DynamicResource ButtonMinHeight}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <ContentControl x:Name="navigationHost" 
                           Grid.Column="0" Grid.ColumnSpan="2"
                           Background="{DynamicResource AppBg}"
                           ZIndex="1000"
                           IsVisible="False"
                           HorizontalContentAlignment="Stretch"
                           VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
