<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vao.Sample.App">
    <Application.Styles>
        <FluentTheme />

        <!-- ============================================
             BRIGHTLAYER UI DESIGN SYSTEM STYLES
             Based on: https://brightlayer-ui.github.io/
             
             Typography: Open Sans (primary), system fallbacks
             ============================================ -->

        <!-- ===========================================
             GLOBAL TYPOGRAPHY - Open Sans (Embedded)
             Brightlayer UI specifies Open Sans as the 
             primary typeface for all UI elements.
             Using embedded fonts via avares:// URI
             =========================================== -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="avares://VaoClientApp/Assets/Fonts#Open Sans, Segoe UI, San Francisco, Roboto, Helvetica Neue, Arial, sans-serif"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="avares://VaoClientApp/Assets/Fonts#Open Sans, Segoe UI, San Francisco, Roboto, Helvetica Neue, Arial, sans-serif"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="FontFamily" Value="avares://VaoClientApp/Assets/Fonts#Open Sans, Segoe UI, San Francisco, Roboto, Helvetica Neue, Arial, sans-serif"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="avares://VaoClientApp/Assets/Fonts#Open Sans, Segoe UI, San Francisco, Roboto, Helvetica Neue, Arial, sans-serif"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="FontFamily" Value="avares://VaoClientApp/Assets/Fonts#Open Sans, Segoe UI, San Francisco, Roboto, Helvetica Neue, Arial, sans-serif"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="FontFamily" Value="avares://VaoClientApp/Assets/Fonts#Open Sans, Segoe UI, San Francisco, Roboto, Helvetica Neue, Arial, sans-serif"/>
        </Style>

        <Style Selector="MenuItem">
            <Setter Property="FontFamily" Value="avares://VaoClientApp/Assets/Fonts#Open Sans, Segoe UI, San Francisco, Roboto, Helvetica Neue, Arial, sans-serif"/>
        </Style>

        <Style Selector="Label">
            <Setter Property="FontFamily" Value="avares://VaoClientApp/Assets/Fonts#Open Sans, Segoe UI, San Francisco, Roboto, Helvetica Neue, Arial, sans-serif"/>
        </Style>

        <!-- Monospace font for code/messages -->
        <Style Selector="TextBlock.monospace">
            <Setter Property="FontFamily" Value="Consolas, Monaco, Courier New, monospace"/>
        </Style>

        <!-- ===========================================
             LAYOUT CONTAINERS
             =========================================== -->

        <!-- Sidebar Shell - Main navigation drawer container -->
        <Style Selector="Border.sidebar-shell">
            <Setter Property="Background" Value="{DynamicResource SidebarBg}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Sidebar Card - Section container with bottom divider -->
        <Style Selector="Border.sidebar-card">
            <Setter Property="Background" Value="{DynamicResource SidebarCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- ===========================================
             EXPANDER / ACCORDION SECTIONS
             Per Brightlayer UI Navigation Drawer pattern
             =========================================== -->

        <!-- Base Expander Toggle Button -->
        <Style Selector="Expander /template/ ToggleButton#PART_toggle">
            <Setter Property="MinHeight" Value="{DynamicResource SidebarMenuHeaderMinHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource SidebarMenuHeaderPadding}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander.sidebar-menu">
            <Setter Property="MinHeight" Value="0"/>
        </Style>

        <!-- Sidebar Menu Expander - Collapsed State -->
        <Style Selector="Expander.sidebar-menu /template/ ToggleButton#PART_toggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarHeaderFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource SidebarMenuHeaderFontSize}"/>
            <Setter Property="MinHeight" Value="{DynamicResource SidebarMenuHeaderMinHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource SidebarMenuHeaderPadding}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- Sidebar Menu Expander - Expanded State (Primary Blue) -->
        <Style Selector="Expander.sidebar-menu:expanded /template/ ToggleButton#PART_toggle">
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHeaderFg}"/>
            <Setter Property="MinHeight" Value="{DynamicResource SidebarMenuHeaderMinHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource SidebarMenuHeaderPadding}"/>
        </Style>

        <!-- Expander Content Text Colors -->
        <Style Selector="Expander.sidebar-menu > StackPanel">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SidebarHeaderFg}"/>
        </Style>
        <Style Selector="Expander.sidebar-menu > StackPanel TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SidebarHeaderFg}"/>
        </Style>
        <Style Selector="Expander.sidebar-menu > WrapPanel">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SidebarHeaderFg}"/>
        </Style>
        <Style Selector="Expander.sidebar-menu > WrapPanel TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SidebarHeaderFg}"/>
        </Style>
        <Style Selector="Expander.sidebar-menu > Grid">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SidebarHeaderFg}"/>
        </Style>
        <Style Selector="Expander.sidebar-menu > Grid TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SidebarHeaderFg}"/>
        </Style>

        <!-- Form Controls in Expander Content -->
        <Style Selector="Expander.sidebar-menu ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource SidebarHeaderFg}"/>
        </Style>
        <Style Selector="Expander.sidebar-menu TextBox">
            <Setter Property="Foreground" Value="{DynamicResource SidebarHeaderFg}"/>
        </Style>

        <!-- Collapsed Expander Content Hidden -->
        <Style Selector="Expander:not(:expanded) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Camera selection section should be edge-to-edge with no extra template spacing -->
        <Style Selector="Expander.camera-selection-section /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Expander.camera-selection-section /template/ ContentPresenter">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Expander.camera-selection-section /template/ Border">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Expander.alarm-selection-section /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Expander.alarm-selection-section /template/ ContentPresenter">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Expander.alarm-selection-section /template/ Border">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Expander Template Border Overrides -->
        <Style Selector="Expander /template/ ToggleButton /template/ Border">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Expander.sidebar-menu /template/ ToggleButton /template/ Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <Style Selector="Expander /template/ ToggleButton ContentPresenter">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- ===========================================
             BUTTONS - Per Brightlayer UI Button Spec
             Hierarchy: Filled > Outlined > Text
             =========================================== -->

        <!-- Base Button Style -->
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="{DynamicResource ButtonMinHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource ButtonPadding}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Button ContentPresenter -->
        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- PRIMARY BUTTON (Filled) - High Emphasis -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryLight}"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryDark}"/>
        </Style>
        <Style Selector="Button.primary:disabled">
            <Setter Property="Opacity" Value="0.38"/>
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- OUTLINED BUTTON - Medium Emphasis -->
        <Style Selector="Button.outlined">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.outlined:pointerover">
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHeaderFg}"/>
        </Style>
        <Style Selector="Button.outlined:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
        </Style>
        <Style Selector="Button.outlined:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryDark}"/>
        </Style>
        <Style Selector="Button.outlined:disabled">
            <Setter Property="Opacity" Value="0.38"/>
        </Style>
        <Style Selector="Button.outlined /template/ ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- TEXT BUTTON - Low Emphasis -->
        <Style Selector="Button.text">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,8"/>
        </Style>
        <Style Selector="Button.text:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
            <Setter Property="Opacity" Value="0.08"/>
        </Style>
        <Style Selector="Button.text:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
            <Setter Property="Opacity" Value="0.12"/>
        </Style>
        <Style Selector="Button.text:disabled">
            <Setter Property="Opacity" Value="0.38"/>
        </Style>

        <!-- ICON BUTTON - For toolbar/icon-only actions -->
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="{DynamicResource ButtonMinHeight}"/>
            <Setter Property="MinWidth" Value="{DynamicResource ButtonMinHeight}"/>
            <Setter Property="CornerRadius" Value="20"/>
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="Button.icon:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface3}"/>
        </Style>

        <!-- PTZ ICON BUTTON - Camera control buttons with visible background -->
        <Style Selector="Button.ptz-icon">
            <Setter Property="Background" Value="{DynamicResource Surface3}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="{DynamicResource ButtonMinHeight}"/>
            <Setter Property="MinWidth" Value="{DynamicResource ButtonMinHeight}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.ptz-icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="Button.ptz-icon:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
        </Style>
        <Style Selector="Button.ptz-icon:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="Button.ptz-icon-transparent">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ptz-icon-transparent:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- APP BAR ICON BUTTON - tuned for top blue app bar -->
        <Style Selector="Button.appbar-icon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHeaderFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="{DynamicResource ButtonMinHeight}"/>
            <Setter Property="MinWidth" Value="{DynamicResource ButtonMinHeight}"/>
            <Setter Property="CornerRadius" Value="20"/>
        </Style>
        <Style Selector="Button.appbar-icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>
        <Style Selector="Button.appbar-icon:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>

        <!-- FAB (Floating Action Button) -->
        <Style Selector="Button.fab">
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHeaderFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.fab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryLight}"/>
        </Style>
        <Style Selector="Button.fab:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryDark}"/>
        </Style>

        <!-- Camera selection button (selected state) -->
        <Style Selector="Button.camera-selected">
            <Setter Property="Background" Value="Goldenrod"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHeaderFg}"/>
        </Style>
        <Style Selector="Button.camera-selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="DarkGoldenrod"/>
        </Style>
        <Style Selector="Button.camera-selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Goldenrod"/>
        </Style>

        <!-- Camera selection list (supports long names and touch-friendly rows) -->
        <Style Selector="ListBox#lstCameraSelection ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="{DynamicResource SidebarMenuItemHeight}"/>
            <Setter Property="Height" Value="{DynamicResource SidebarMenuItemHeight}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="ListBox#lstCameraSelection ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox#lstCameraSelection ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHeaderFg}"/>
        </Style>
        <Style Selector="ListBox#lstCameraSelection ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface3}"/>
        </Style>

        <Style Selector="ListBox#lstAlarmSelection ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="{DynamicResource SidebarMenuItemHeight}"/>
            <Setter Property="Height" Value="{DynamicResource SidebarMenuItemHeight}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="ListBox#lstAlarmSelection ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox#lstAlarmSelection ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHeaderFg}"/>
        </Style>
        <Style Selector="ListBox#lstAlarmSelection ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface3}"/>
        </Style>

        <Style Selector="Border.sidebar-menu-resize-handle">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Cursor" Value="SizeNorthSouth"/>
        </Style>
        <Style Selector="Border.sidebar-menu-resize-handle:pointerover">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <!-- ===========================================
             LIST ITEMS
             =========================================== -->

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="{DynamicResource ListItemMinHeight}"/>
        </Style>

        <!-- Compact List Items (for messages) -->
        <Style Selector="ListBoxItem.compact">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>

        <!-- ===========================================
             FORM CONTROLS
             =========================================== -->

        <!-- TextBox -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="{DynamicResource InputMinHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource InputPadding}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <!-- ComboBox -->
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="{DynamicResource InputMinHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource InputPadding}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <!-- ===========================================
             ICONS
             =========================================== -->

        <Style Selector="Image.theme-icon">
            <Setter Property="Opacity" Value="0.87"/>
        </Style>

        <!-- Material Symbols Icon TextBlock -->
        <Style Selector="TextBlock.ms-icon">
            <Setter Property="FontFamily" Value="{DynamicResource MaterialSymbolsFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource IconSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Brightlayer UI Icon TextBlock -->
        <Style Selector="TextBlock.blui-icon">
            <Setter Property="FontFamily" Value="{DynamicResource BrightlayerIconFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource IconSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- ===========================================
             DATE/TIME PICKERS
             =========================================== -->

        <Style Selector="DatePicker /template/ Button">
            <Setter Property="MinHeight" Value="{DynamicResource InputMinHeight}"/>
            <Setter Property="Height" Value="{DynamicResource InputMinHeight}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="DatePicker /template/ Button Grid">
            <Setter Property="MinWidth" Value="180"/>
        </Style>
        <Style Selector="DatePicker /template/ Button TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="30"/>
        </Style>

        <Style Selector="TimePicker /template/ Button">
            <Setter Property="MinHeight" Value="{DynamicResource InputMinHeight}"/>
            <Setter Property="Height" Value="{DynamicResource InputMinHeight}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TimePicker /template/ Button Grid">
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        <Style Selector="TimePicker /template/ Button TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="30"/>
        </Style>

        <!-- ===========================================
             TYPOGRAPHY CLASSES
             Per Brightlayer UI Type Scale
             =========================================== -->

        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="{DynamicResource SectionHeaderFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarHeaderFg}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style Selector="TextBlock.page-header-title">
            <Setter Property="FontSize" Value="{DynamicResource PageHeaderTitleFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.page-header-subtitle">
            <Setter Property="FontSize" Value="{DynamicResource PageHeaderSubtitleFontSize}"/>
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelFg}"/>
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style Selector="TextBlock.body1">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Regular"/>
        </Style>

        <Style Selector="TextBlock.body2">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Regular"/>
        </Style>

        <Style Selector="TextBlock.subtitle1">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.subtitle2">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.overline">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBox.borderless">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="TextBox.borderless:focus">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.borderless:pointerover">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.borderless /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <!-- ===========================================
                 BRIGHTLAYER UI TYPOGRAPHY
                 Primary: Open Sans (Embedded)
                 Monospace: Consolas
                 =========================================== -->
            <FontFamily x:Key="BrightlayerFont">avares://VaoClientApp/Assets/Fonts#Open Sans, Segoe UI, San Francisco, Roboto, Helvetica Neue, Arial, sans-serif</FontFamily>
            <FontFamily x:Key="MonospaceFont">Consolas, Monaco, Courier New, monospace</FontFamily>
            <FontFamily x:Key="MaterialSymbolsFont">avares://VaoClientApp/Assets/Fonts#Material Symbols Outlined</FontFamily>
            <FontFamily x:Key="BrightlayerIconFont">avares://VaoClientApp/Assets/Fonts#Brightlayer UI Icons</FontFamily>

            <!-- ===========================================
                 BRIGHTLAYER UI SPACING SYSTEM (8px Grid)
                 =========================================== -->
            <x:Double x:Key="Spacing-xs">4</x:Double>
            <x:Double x:Key="Spacing-sm">8</x:Double>
            <x:Double x:Key="Spacing-md">16</x:Double>
            <x:Double x:Key="Spacing-lg">24</x:Double>
            <x:Double x:Key="Spacing-xl">32</x:Double>

            <!-- ===========================================
                 COMPONENT SIZES
                 =========================================== -->
            <x:Double x:Key="AppBarHeight">64</x:Double>
            <x:Double x:Key="SidebarWidth">280</x:Double>
            <x:Double x:Key="SidebarCollapsedWidth">56</x:Double>
            <x:Double x:Key="ButtonMinHeight">44</x:Double>
            <x:Double x:Key="InputMinHeight">44</x:Double>
            <x:Double x:Key="ListItemMinHeight">48</x:Double>
            <x:Double x:Key="AvatarSize">44</x:Double>
            <CornerRadius x:Key="AvatarCornerRadius">22</CornerRadius>
            <x:Double x:Key="IconSize">24</x:Double>
            <x:Double x:Key="IconSizeSmall">20</x:Double>
            <x:Double x:Key="SidebarMenuHeaderFontSize">14</x:Double>
            <x:Double x:Key="SectionHeaderFontSize">16</x:Double>
            <x:Double x:Key="PageHeaderTitleFontSize">20</x:Double>
            <x:Double x:Key="PageHeaderSubtitleFontSize">12</x:Double>

            <!-- Component Padding -->
            <Thickness x:Key="ButtonPadding">16,8</Thickness>
            <Thickness x:Key="InputPadding">12,8</Thickness>
            <Thickness x:Key="PageMargin">24</Thickness>
            <Thickness x:Key="PageMarginNoBottom">24,24,24,0</Thickness>
            <Thickness x:Key="CardPadding">16</Thickness>
            <Thickness x:Key="SectionPadding">24</Thickness>
            <Thickness x:Key="DialogPadding">24,16</Thickness>

            <ResourceDictionary.ThemeDictionaries>
                <!-- ===========================================
                     DARK THEME - Brightlayer UI Colors
                     =========================================== -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Background Colors - Layered depth system -->
                    <SolidColorBrush x:Key="AppBg" Color="#121212" />
                    <SolidColorBrush x:Key="SectionBg" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="SidebarBg" Color="#121212" />
                    <SolidColorBrush x:Key="SidebarCardBg" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="VideoBg" Color="#000000" />
                    <SolidColorBrush x:Key="VideoHeaderBg" Color="#1E1E1E" />

                    <!-- Surface Elevation (per Material/Brightlayer) -->
                    <SolidColorBrush x:Key="Surface1" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="Surface2" Color="#2C2C2C" />
                    <SolidColorBrush x:Key="Surface3" Color="#3D3D3D" />

                    <!-- Border/Divider Colors -->
                    <SolidColorBrush x:Key="Divider" Color="#FFFFFF" Opacity="0.12" />
                    <SolidColorBrush x:Key="SidebarBorder" Color="#FFFFFF" Opacity="0.12" />

                    <!-- Text Colors - Brightlayer UI Opacity System -->
                    <SolidColorBrush x:Key="SidebarHeaderFg" Color="#FFFFFF" Opacity="0.87" />
                    <SolidColorBrush x:Key="LabelFg" Color="#FFFFFF" Opacity="0.60" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#FFFFFF" Opacity="0.38" />

                    <!-- Brand Colors - Eaton/Brightlayer Blue -->
                    <SolidColorBrush x:Key="Primary" Color="#007BC1" />
                    <SolidColorBrush x:Key="PrimaryLight" Color="#0088D0" />
                    <SolidColorBrush x:Key="PrimaryDark" Color="#006BA1" />

                    <!-- Semantic Colors -->
                    <SolidColorBrush x:Key="Success" Color="#39B620" />
                    <SolidColorBrush x:Key="Warning" Color="#F0AA1F" />
                    <SolidColorBrush x:Key="Error" Color="#CA3C3D" />
                    <SolidColorBrush x:Key="Info" Color="#007BC1" />
                </ResourceDictionary>

                <!-- ===========================================
                     LIGHT THEME - Brightlayer UI Colors
                     =========================================== -->
                <ResourceDictionary x:Key="Light">
                    <!-- Background Colors -->
                    <SolidColorBrush x:Key="AppBg" Color="#EEEEEE" />
                    <SolidColorBrush x:Key="SectionBg" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="SidebarBg" Color="#F6F6F6" />
                    <SolidColorBrush x:Key="SidebarCardBg" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="VideoBg" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="VideoHeaderBg" Color="#007BC1" />

                    <!-- Surface Elevation -->
                    <SolidColorBrush x:Key="Surface1" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="Surface2" Color="#EFEFEF" />
                    <SolidColorBrush x:Key="Surface3" Color="#E3E3E3" />

                    <!-- Border/Divider Colors -->
                    <SolidColorBrush x:Key="Divider" Color="#000000" Opacity="0.12" />
                    <SolidColorBrush x:Key="SidebarBorder" Color="#D4D4D4" />

                    <!-- Text Colors - Brightlayer UI Opacity System -->
                    <SolidColorBrush x:Key="SidebarHeaderFg" Color="#000000" Opacity="0.87" />
                    <SolidColorBrush x:Key="LabelFg" Color="#000000" Opacity="0.60" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#000000" Opacity="0.38" />

                    <!-- Brand Colors - Eaton/Brightlayer Blue -->
                    <SolidColorBrush x:Key="Primary" Color="#007BC1" />
                    <SolidColorBrush x:Key="PrimaryLight" Color="#0088D0" />
                    <SolidColorBrush x:Key="PrimaryDark" Color="#006BA1" />

                    <!-- Semantic Colors -->
                    <SolidColorBrush x:Key="Success" Color="#39B620" />
                    <SolidColorBrush x:Key="Warning" Color="#F0AA1F" />
                    <SolidColorBrush x:Key="Error" Color="#CA3C3D" />
                    <SolidColorBrush x:Key="Info" Color="#007BC1" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
