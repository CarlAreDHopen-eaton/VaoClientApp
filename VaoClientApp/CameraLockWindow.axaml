<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Vao.Sample.CameraLockWindow"
        Title="Camera Lock"
        Width="220" Height="170" MinWidth="100" MinHeight="100"
        Background="{DynamicResource AppBg}"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="12" Spacing="8">
        <TextBlock Text="Camera lock" FontWeight="Bold" Foreground="{DynamicResource PrimaryHeaderFg}"/>
        <TextBlock Text="Timeout" Foreground="{DynamicResource TextSecondary}"/>
        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Hour" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Min" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Sec" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
            <NumericUpDown Grid.Row="1" Grid.Column="0" x:Name="numUpDownHour" Minimum="0" Maximum="24" Value="0" FormatString="0" ValueChanged="numUpDown_ValueChanged"/>
            <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="numUpDownMin" Minimum="0" Maximum="59" Value="0" FormatString="0" ValueChanged="numUpDown_ValueChanged"/>
            <NumericUpDown Grid.Row="1" Grid.Column="2" x:Name="numUpDownSec" Minimum="0" Maximum="59" Value="0" FormatString="0" ValueChanged="numUpDown_ValueChanged"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="btnCancel_Click"/>
            <Button Content="Send" Click="btnSend_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
