<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Vao.Sample.DownloadWindow"
        Title="Download Recording"
        Width="1118" Height="637" MinWidth="600" MinHeight="400"
        Background="{DynamicResource AppBg}"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="64,*">
        <!-- Header (64px per Brightlayer UI Dialog spec) -->
        <Border Grid.Row="0" Background="{DynamicResource Primary}" BoxShadow="0 2 4 0 #40000000">
            <StackPanel VerticalAlignment="Center" Margin="24,0">
                <TextBlock Text="Download Recording"
                           FontSize="20"
                           FontWeight="Medium"
                           Foreground="{DynamicResource PrimaryHeaderFg}"/>
                <TextBlock Text="Export video recordings from recorders"
                           FontSize="12"
                           Foreground="{DynamicResource PrimaryHeaderFg}"
                           Opacity="0.7"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" ColumnDefinitions="420,*">
            <!-- Left panel -->
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="0" Margin="0">

                    <!-- Available Recordings -->
                    <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="16" x:Name="grpSelectRecording">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Available Recordings" Classes="section-header"/>
                            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Camera" Classes="label" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="selCamera" SelectionChanged="selCamera_SelectedIndexChanged" HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Recordings" Classes="label" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="selRecording" SelectionChanged="selRecording_SelectedIndexChanged" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Request Download -->
                    <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="16" x:Name="grpDownload">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Request Download" Classes="section-header"/>
                            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Recorder" Classes="label" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtRecorderAddress"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Stream" Classes="label" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="selStreamNumber" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                            </Grid>
                            <TextBlock Text="Start time" Classes="label" Margin="0,8,0,0"/>
                            <Grid ColumnDefinitions="*,8,*">
                                <DatePicker Grid.Column="0" x:Name="startDatePicker" HorizontalAlignment="Stretch"/>
                                <TimePicker Grid.Column="2" x:Name="startTimePicker" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid ColumnDefinitions="80,*">
                                <TextBlock Grid.Column="0" Text="Duration" Classes="label" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="selDuration" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Button x:Name="btnDownloadRequest" Content="Download" Click="btnDownloadRequest_Click" Margin="0,8,0,0" Classes="primary" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Right panel -->
            <Grid Grid.Column="1" RowDefinitions="*,*,*" Margin="0">
                <!-- Pending Downloads -->
                <Border Grid.Row="0" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="16">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Text="Pending Downloads" Classes="section-header"/>
                        <ListBox Grid.Row="1" x:Name="lstPendingDownloads" Background="Transparent" Margin="0,8"/>
                        <Button Grid.Row="2" Content="Clear" Click="btnClearPendingDownloads_Click" HorizontalAlignment="Right" Classes="outlined"/>
                    </Grid>
                </Border>

                <!-- Finished Downloads -->
                <Border Grid.Row="1" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="16">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Text="Finished Downloads" Classes="section-header"/>
                        <ListBox Grid.Row="1" x:Name="lstFinishedDownloads" Background="Transparent" Margin="0,8"/>
                        <Button Grid.Row="2" Content="Clear" Click="btnClearFinishedDownloads_Click" HorizontalAlignment="Right" Classes="outlined"/>
                    </Grid>
                </Border>

                <!-- Messages -->
                <Border Grid.Row="2" Background="{DynamicResource Surface1}" Padding="16">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Text="Messages" Classes="section-header"/>
                        <ListBox Grid.Row="1" x:Name="lstDownloadMessages" Background="Transparent" FontFamily="{StaticResource MonospaceFont}" FontSize="11" Margin="0,8"/>
                        <Button Grid.Row="2" Content="Clear" Click="btnClearDownloadMessages_Click" HorizontalAlignment="Right" Classes="outlined"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
