<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="Vao.Sample.Controls.MessageLogPanel">

	<Border x:Name="brdMessages" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="4">
		<Grid RowDefinitions="Auto,*">
			<!-- Column headers -->
			<Border Grid.Row="0" Background="{DynamicResource Surface3}" CornerRadius="4,4,0,0" Padding="16,6">
				<Grid ColumnDefinitions="160,80,80,*">
					<TextBlock Grid.Column="0" Text="Time" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SidebarHeaderFg}"/>
					<TextBlock Grid.Column="1" Text="Level" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SidebarHeaderFg}"/>
					<TextBlock Grid.Column="2" Text="Source" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SidebarHeaderFg}"/>
					<TextBlock Grid.Column="3" Text="Message" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SidebarHeaderFg}"/>
				</Grid>
			</Border>
			<ListBox Grid.Row="1" x:Name="lstMessages" Background="Transparent" FontFamily="{StaticResource MonospaceFont}" FontSize="12" Margin="0" SelectionMode="Multiple" KeyDown="lstMessages_KeyDown">
				<ListBox.Styles>
					<Style Selector="ListBoxItem">
						<Setter Property="Padding" Value="0"/>
						<Setter Property="MinHeight" Value="0"/>
						<Setter Property="Margin" Value="0"/>
					</Style>
				</ListBox.Styles>
				<ListBox.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Scroll to End" Click="menuScrollToEnd_Click"/>
						<Separator/>
						<MenuItem Header="Copy Selected" Click="menuCopySelectedMessages_Click"/>
						<MenuItem Header="Copy All" Click="menuCopyMessages_Click"/>
						<MenuItem Header="Clear" Click="btnClearMessages_Click"/>
						<Separator/>
						<MenuItem x:Name="menuFilterFlexApi" Header="Show FlexApi" Click="menuFilterFlexApi_Click">
							<MenuItem.Icon>
								<CheckBox IsChecked="True" IsHitTestVisible="False"/>
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem x:Name="menuFilterLibVlc" Header="Show LibVlc" Click="menuFilterLibVlc_Click">
							<MenuItem.Icon>
								<CheckBox IsChecked="True" IsHitTestVisible="False"/>
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem x:Name="menuFilterConfig" Header="Show Config" Click="menuFilterConfig_Click">
							<MenuItem.Icon>
								<CheckBox IsChecked="True" IsHitTestVisible="False"/>
							</MenuItem.Icon>
						</MenuItem>
					</ContextMenu>
				</ListBox.ContextMenu>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border Background="{Binding Background}" Padding="16,2">
							<Grid ColumnDefinitions="160,80,80,*">
								<TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="{Binding Color}"/>
								<TextBlock Grid.Column="1" Text="{Binding LevelText}" Foreground="{Binding Color}"/>
								<TextBlock Grid.Column="2" Text="{Binding SourceText}" Foreground="{Binding Color}"/>
								<TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{Binding Color}" TextTrimming="CharacterEllipsis"/>
							</Grid>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>
	</Border>

</UserControl>
