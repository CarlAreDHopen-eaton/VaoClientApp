<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Vao.Sample.AbsolutePositionWindow"
        Title="Camera absolute position"
        Width="200" Height="200" MinWidth="100" MinHeight="100"
        Background="{DynamicResource AppBg}"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="12" Spacing="8">
        <TextBlock Text="Absolute position" FontWeight="Bold" Foreground="{DynamicResource PrimaryHeaderFg}"/>
        <Grid ColumnDefinitions="50,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pan" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtAbsolutePan" TextChanged="txtAbsoluteValue_TextChanged"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tilt" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtAbsoluteTilt" TextChanged="txtAbsoluteValue_TextChanged"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Zoom" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtAbsoluteZoom" TextChanged="txtAbsoluteValue_TextChanged"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="btnCancel_Click"/>
            <Button x:Name="btnSendAbsolutePosition" Content="Send" IsEnabled="False" Click="btnSendAbsolutePosition_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
