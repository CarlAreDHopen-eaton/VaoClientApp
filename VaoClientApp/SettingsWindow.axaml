<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="Vao.Sample.SettingsWindow"
		Title="Settings"
		Width="500" Height="700" MinWidth="450" MinHeight="600"
		Background="{DynamicResource AppBg}"
		WindowStartupLocation="CenterOwner"
		CanResize="False">

	<Grid RowDefinitions="64,*,Auto">
		<!-- Header (64px per Brightlayer UI App Bar spec) -->
		<Border Grid.Row="0" Background="{DynamicResource Primary}" BoxShadow="0 2 4 0 #40000000">
			<StackPanel VerticalAlignment="Center" Margin="24,0">
				<TextBlock Text="Settings" 
						   FontSize="20" 
						   FontWeight="Medium"
						   Foreground="{DynamicResource PrimaryHeaderFg}"/>
				<TextBlock Text="Configure application preferences" 
						   FontSize="12" 
						   Foreground="{DynamicResource PrimaryHeaderFg}"
						   Opacity="0.7"/>
			</StackPanel>
		</Border>

		<!-- Content (24px padding per Brightlayer UI) -->
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Margin="24" Spacing="24">

				<!-- Connection Settings Section -->
				<StackPanel Spacing="16">
					<TextBlock Text="Connection Settings" Classes="section-header"/>

					<StackPanel Spacing="12">
						<Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
							<TextBlock Grid.Column="0" Text="Host" Classes="label" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="txtHost" Watermark="Enter host address"/>
						</Grid>
						<Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
							<TextBlock Grid.Column="0" Text="Port" Classes="label" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="txtPort" Watermark="444"/>
						</Grid>
						<Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
							<TextBlock Grid.Column="0" Text="Username" Classes="label" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="txtUser" Watermark="Enter username"/>
						</Grid>
						<Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
							<TextBlock Grid.Column="0" Text="Password" Classes="label" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="txtPassword" PasswordChar="*" Watermark="Enter password"/>
						</Grid>
						<CheckBox x:Name="chkSecure" Content="Use HTTPS (Secure)" Margin="0,8,0,0"/>
						<CheckBox x:Name="chkAutoConnect" Content="Auto-connect on startup"/>
					</StackPanel>
				</StackPanel>

				<!-- Divider -->
				<Border Height="1" Background="{DynamicResource Divider}"/>

				<!-- Stream Settings Section -->
				<StackPanel Spacing="16">
					<TextBlock Text="Stream Settings" Classes="section-header"/>

					<StackPanel Spacing="12">
						<CheckBox x:Name="chkUseTcp" Content="Use TCP protocol (instead of UDP)"/>
						<CheckBox x:Name="chkPreferSubChannel" Content="Prefer sub-channel for streaming"/>
					</StackPanel>
				</StackPanel>

				<!-- Divider -->
				<Border Height="1" Background="{DynamicResource Divider}"/>

				<!-- Download Settings Section -->
				<StackPanel Spacing="16">
					<TextBlock Text="Download Settings" Classes="section-header"/>

					<StackPanel Spacing="12">
						<Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
							<TextBlock Grid.Column="0" Text="FTP User" Classes="label" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="txtFTPUser" Watermark="Enter FTP username"/>
						</Grid>
						<Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
							<TextBlock Grid.Column="0" Text="FTP Password" Classes="label" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="txtFTPPassword" PasswordChar="*" Watermark="Enter FTP password"/>
						</Grid>
						<Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
							<TextBlock Grid.Column="0" Text="Download Path" Classes="label" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="txtDownloadPath" Watermark="Select download folder"/>
						</Grid>
						<Button Content="Browse" Click="btnBrowseDownloadPath_Click" Classes="outlined" HorizontalAlignment="Left" Margin="120,0,0,0"/>
					</StackPanel>
				</StackPanel>

				<!-- Divider -->
				<Border Height="1" Background="{DynamicResource Divider}"/>

				<!-- Appearance Section -->
				<StackPanel Spacing="16">
					<TextBlock Text="Appearance" Classes="section-header"/>

					<StackPanel Spacing="4">
						<TextBlock Text="Theme" Classes="label"/>
						<ComboBox x:Name="cmbTheme" SelectionChanged="cmbTheme_SelectionChanged"/>
					</StackPanel>
				</StackPanel>

			</StackPanel>
		</ScrollViewer>

		<!-- Footer Actions (Right-aligned per Brightlayer UI Dialog spec) -->
		<Border Grid.Row="2" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,16">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
				<Button Content="Cancel" Click="btnCancel_Click" Classes="outlined" MinWidth="100"/>
				<Button Content="Save" Click="btnSave_Click" Classes="primary" MinWidth="100"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>
