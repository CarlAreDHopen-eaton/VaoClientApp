<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vao.Sample.Pages.AbsolutePositionPage"
             Background="{DynamicResource AppBg}">

    <Grid RowDefinitions="Auto,*,Auto">
                <Border Grid.Row="0" Height="{DynamicResource AppBarHeight}" Background="{DynamicResource Primary}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="16,0" ClipToBounds="True">
                    <Grid ColumnDefinitions="Auto,*">
                        <Button Grid.Column="0"
                                x:Name="btnBack"
                                Click="btnBack_Click"
                                Width="40" Height="40"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0">
                            <TextBlock Text="&#xE5C4;" Classes="ms-icon" FontSize="20" Foreground="{DynamicResource PrimaryHeaderFg}"/>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="Camera Absolute Position"
                                       Classes="page-header-title"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryHeaderFg}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Spacing="16" Margin="{DynamicResource PageMargin}" VerticalAlignment="Top">
            <StackPanel Spacing="8">
                <TextBlock Text="Pan (degrees)" FontSize="14" FontWeight="Medium"/>
                <TextBox x:Name="txtAbsolutePan" Watermark="Enter pan value" MinHeight="44" Padding="12,8" TextChanged="txtAbsoluteValue_TextChanged" FontSize="14"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Tilt (degrees)" FontSize="14" FontWeight="Medium"/>
                <TextBox x:Name="txtAbsoluteTilt" Watermark="Enter tilt value" MinHeight="44" Padding="12,8" TextChanged="txtAbsoluteValue_TextChanged" FontSize="14"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Zoom" FontSize="14" FontWeight="Medium"/>
                <TextBox x:Name="txtAbsoluteZoom" Watermark="Enter zoom value" MinHeight="44" Padding="12,8" TextChanged="txtAbsoluteValue_TextChanged" FontSize="14"/>
            </StackPanel>
                </StackPanel>

                <Border Grid.Row="2" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button Content="Cancel" Click="btnCancel_Click" Classes="outlined" MinWidth="120" MinHeight="48" FontSize="14"/>
                        <Button x:Name="btnSendAbsolutePosition" Content="Send" IsEnabled="False" Click="btnSendAbsolutePosition_Click" Classes="primary" MinWidth="120" MinHeight="48" FontSize="14"/>
                    </StackPanel>
                </Border>
    </Grid>
</UserControl>
